{
    "id": "com.dipper.AIFileCleaner",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.7",
    "sdk": "org.kde.Sdk",
    "base": "com.riverbankcomputing.PyQt.BaseApp",
    "base-version": "5.15-24.08",
    "command": "ai-file-cleaner",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=home",
        "--filesystem=/tmp",
        "--filesystem=/var/tmp",
        "--socket=pulseaudio",
        "--env=AI_CLEANER_FLATPAK=1"
    ],
    "modules": [
        {
            "name": "ai-file-cleaner",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/share/ai-file-cleaner",
                "cp -r ai_cleaner /app/share/ai-file-cleaner/ai_cleaner",
                "install -Dm755 ai-file-cleaner.sh /app/bin/ai-file-cleaner",
                "install -Dm644 com.dipper.AIFileCleaner.desktop /app/share/applications/com.dipper.AIFileCleaner.desktop",
                "install -Dm644 com.dipper.AIFileCleaner.metainfo.xml /app/share/metainfo/com.dipper.AIFileCleaner.metainfo.xml",
                "install -Dm644 com.dipper.AIFileCleaner.svg /app/share/icons/hicolor/scalable/apps/com.dipper.AIFileCleaner.svg"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "src"
                },
                {
                    "type": "file",
                    "path": "ai-file-cleaner.sh"
                },
                {
                    "type": "file",
                    "path": "com.dipper.AIFileCleaner.desktop"
                },
                {
                    "type": "file",
                    "path": "com.dipper.AIFileCleaner.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "com.dipper.AIFileCleaner.svg"
                }
            ]
        }
    ]
}